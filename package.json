{
  "name": "frontend-ai-context-kit",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.11.0",
  "scripts": {
    "dev": "pnpm --filter @frontend-ai-context-kit/web dev",
    "storybook": "pnpm --filter @frontend-ai-context-kit/ui storybook",
    "clean:storybook": "pnpm --filter @frontend-ai-context-kit/ui clean:storybook",
    "build": "pnpm generate:index && pnpm -r --if-present build",
    "typecheck": "pnpm -r --if-present typecheck",
    "lint": "eslint . --max-warnings 0",
    "generate:index": "pnpm --filter @frontend-ai-context-kit/docs-indexer generate"
  },
  "devDependencies": {
    "@eslint/js": "^9.22.0",
    "@storybook/addon-essentials": "^8.6.7",
    "@storybook/addon-interactions": "^8.6.7",
    "@storybook/react": "^8.6.7",
    "@storybook/react-vite": "^8.6.7",
    "@types/node": "^22.13.10",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "@vitejs/plugin-react": "^4.3.4",
    "eslint": "^9.22.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.19",
    "prettier": "^3.5.3",
    "storybook": "^8.6.7",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2",
    "typescript-eslint": "^8.26.1",
    "vite": "^6.2.0"
  }
}
